# Backend Environment Variables Template
PORT=8000

# Option 1 (preferred, free): Gemma directly via Google AI Studio. Takes priority when set.
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# Option 2: Gemma via OpenRouter. Used only if GOOGLE_API_KEY is not set.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
AI_MODEL=google/gemma-3-27b-it

GITHUB_TOKEN=your_github_personal_access_token_here

# Auth: sign-in token secret (use a long random string) and the seeded admin account.
JWT_SECRET=replace_with_a_long_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_admin_password
